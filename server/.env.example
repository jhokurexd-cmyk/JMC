DATABASE_URL="postgresql://clinic:clinic_dev_pw@localhost:5432/clinic?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# First-run admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="owner@clinic.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Report feed for Excel / Google Sheets. Leave blank to disable the feed.
# Set to a long random string; anyone with it + the URL can read report CSVs.
# Rotate it (and restart) to revoke access.
REPORT_TOKEN=""
# Public base URL of the API (used to build the feed links shown in the app).
# Falls back to the request host if unset.
PUBLIC_URL=""
